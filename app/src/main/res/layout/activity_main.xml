<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <TextView android:id="@+id/zoomBadge"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="48dp"
        android:background="#99000000" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="4dp" android:paddingBottom="4dp"
        android:textColor="#FFC107" android:textSize="16sp" android:textStyle="bold"
        android:visibility="gone" android:text="2x" />

    <TextView android:id="@+id/updateButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_marginTop="12dp" android:layout_marginEnd="12dp"
        android:background="#99000000" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="6dp" android:paddingBottom="6dp" android:minHeight="32dp"
        android:gravity="center" android:clickable="true" android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:textColor="#FFFFFF" android:textSize="12sp" android:text="檢查更新" />

    <TextView android:id="@+id/holdHint"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:background="@drawable/hint_bg"
        android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingTop="14dp" android:paddingBottom="14dp" android:gravity="center"
        android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:gravity="center_horizontal" android:background="#B3000000"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="12dp" android:paddingBottom="28dp">

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/modeNormal" style="@style/ModeButton"
                android:checked="true" android:text="一般疊圖" />
            <RadioButton android:id="@+id/modeNight" style="@style/ModeButton"
                android:text="夜景" />
            <RadioButton android:id="@+id/modeHdr" style="@style/ModeButton"
                android:text="HDR\n強對比" />
            <RadioButton android:id="@+id/modeSr" style="@style/ModeButton"
                android:text="超解析\n變焦" />
        </RadioGroup>

        <TextView android:id="@+id/modeHint"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center"
            android:textColor="#DDDDDD" android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/zoomGroup"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal"
            android:visibility="gone">
            <RadioButton android:id="@+id/zoom2" style="@style/ZoomButton"
                android:checked="true" android:text="2x" />
            <RadioButton android:id="@+id/zoom3" style="@style/ZoomButton"
                android:text="3x" />
        </RadioGroup>

        <RadioGroup
            android:id="@+id/nightGroup"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
            android:orientation="horizontal" android:visibility="gone">
            <RadioButton android:id="@+id/nightA" style="@style/VariantButton"
                android:checked="true" android:text="A\n降噪" />
            <RadioButton android:id="@+id/nightB" style="@style/VariantButton"
                android:text="B\nRAW" />
            <RadioButton android:id="@+id/nightC" style="@style/VariantButton"
                android:text="C\n提亮" />
            <RadioButton android:id="@+id/nightD" style="@style/VariantButton"
                android:text="D\nRAW提亮" />
        </RadioGroup>

        <TextView android:id="@+id/status"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="15sp"
            android:layout_marginTop="8dp" android:text="拍照時請盡量拿穩" />

        <ProgressBar android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="240dp" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:max="100" android:visibility="invisible"/>

        <FrameLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <ImageView android:id="@+id/thumb"
                android:layout_width="60dp" android:layout_height="60dp"
                android:layout_gravity="start|center_vertical" android:layout_marginStart="24dp"
                android:background="@drawable/thumb_bg" android:padding="2dp"
                android:scaleType="centerCrop" android:clickable="true" android:focusable="true"
                android:contentDescription="查看照片" />

            <ImageButton android:id="@+id/shutter"
                android:layout_width="80dp" android:layout_height="80dp"
                android:layout_gravity="center" android:background="@drawable/shutter"
                android:contentDescription="快門"/>

            <LinearLayout android:id="@+id/queueBox"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical" android:layout_marginEnd="16dp"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:visibility="invisible">
                <ProgressBar
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp" android:layout_height="24dp" />
                <TextView android:id="@+id/queueText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFC107" android:textSize="12sp" android:text="處理中 1" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
